# Database & Runtime Configuration
DATABASE_URL=
SQL_PORT=5432
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Showcase Mode Gate (true|false)
SHOWCASE_MODE=true
# Explicit local/test facilities; keep both false for the judge/demo deployment.
ENABLE_DEMO_IDENTITIES=false
SHOWCASE_DEBUG=false

# Application URL
APP_URL=

# Firebase Authentication
FIREBASE_PROJECT_ID=

# Main Text Intelligence (UnoRouter or Gemini)
AI_PROVIDER=unorouter
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
UNOROUTER_API_KEY=
AI_MODEL=gpt-oss-20b:free
AI_FALLBACK_MODEL=
# Optional alternate provider (gemini|unorouter), with its own server key.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_PROVIDER_MODEL=
AI_TIMEOUT_MS=14000
GEMINI_API_KEY=

# Voice Auvresence (Groq Speech-to-Text & Text-to-Speech)
STT_PROVIDER=groq
STT_MODEL=
TTS_PROVIDER=groq
TTS_MODEL=
GROQ_API_KEY=

# Auvresence Vision (Hugging Face Router — Optional)
VISION_PROVIDER=huggingface
VISION_BASE_URL=https://router.huggingface.co/v1
VISION_MODEL=Qwen/Qwen3.8-27B:novita
HF_TOKEN=

# Optional Embeddings
EMBEDDING_PROVIDER=unorouter
EMBEDDING_MODEL=
