# Database & Runtime Configuration
DATABASE_URL=
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Showcase Mode Gate (true|false)
SHOWCASE_MODE=true

# Application URL
APP_URL=

# Firebase Authentication
FIREBASE_PROJECT_ID=

# Main Text Intelligence (UnoRouter or Gemini)
AI_PROVIDER=unorouter
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
UNOROUTER_API_KEY=
AI_MODEL=
AI_FALLBACK_MODEL=
GEMINI_API_KEY=

# Voice Auvresence (Groq Speech-to-Text & Text-to-Speech)
STT_PROVIDER=groq
STT_MODEL=
TTS_PROVIDER=groq
TTS_MODEL=
GROQ_API_KEY=

# Auvresence Vision (Hugging Face Router — Optional)
VISION_PROVIDER=huggingface
VISION_BASE_URL=https://router.huggingface.co/v1
VISION_MODEL=Qwen/Qwen3.8-27B:novita
HF_TOKEN=

# Optional Embeddings
EMBEDDING_PROVIDER=unorouter
EMBEDDING_MODEL=
